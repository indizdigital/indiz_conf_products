#config.contentObjectExceptionHandler = 0

plugin.tx_products_index {
  view {
    templateRootPaths.10 = EXT:products/Resources/Private/Templates/
    partialRootPaths.10 = EXT:products/Resources/Private/Partials/
    layoutRootPaths.10 = EXT:products/Resources/Private/Layouts/
  }
  persistence {
    storagePid = 
  }
  settings {
    orderpid = 28
  }
}
plugin.tx_insights_import < plugin.tx_products_index
plugin.tx_insights_view < plugin.tx_products_index
plugin.tx_insights_tease < plugin.tx_products_index

lib.renderContentElement = RECORDS
lib.renderContentElement {
    tables = tt_content
    source.current = 1
    dontCheckPid = 1
}


lib.renderHeaderElement = RECORDS
lib.renderHeaderElement {
    tables = tt_content
    source = 163
    dontCheckPid = 1
}

lib.renderInsightHeaderElement = RECORDS
lib.renderInsightHeaderElement {
    tables = tt_content
    source = 402
    dontCheckPid = 1
}

# Ensure legacy TYPO3 <link ...>text</link> tags in bodytext fields
# (e.g. Insight.bodytext) are resolved to real <a> tags via typolink.
lib.parseFunc_RTE {
    makelinks = 1
    makelinks {
        http.keep = path
        mailto.keep = path
    }
    tags.link = TEXT
    tags.link {
        current = 1
        typolink.parameter.data = parameters : allParams
    }
}
